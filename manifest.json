{
  "manifest_version": 3,
  "name": "GeekRTL",
  "version": "2.0.0",
  "description": "Right-to-left fix for Persian and Arabic text on AI chat platforms. By GeekMani.",
  "icons": {
    "16": "icons/geekrtl-icon-16.png",
    "32": "icons/geekrtl-icon-32.png",
    "48": "icons/geekrtl-icon-48.png",
    "128": "icons/geekrtl-icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/geekrtl-icon-16.png",
      "32": "icons/geekrtl-icon-32.png",
      "48": "icons/geekrtl-icon-48.png"
    },
    "default_title": "GeekRTL"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sites/sites.json",
        "fonts/vazirmatn/*.woff2",
        "fonts/jetbrains-mono/*.woff2"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content/rtl-fixer.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/mani-imani/GeekRTL"
}
